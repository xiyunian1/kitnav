// Prisma schema —— AI 聚合站
// 文档: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 用户与认证 ----------

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  credits       Int        @default(0)
  sessionVersion Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts           Account[]
  sessions           Session[]
  generations        Generation[]
  creditTransactions CreditTransaction[]
  orders             Order[]
  apiConfigs         UserApiConfig[]
  imageConversations ImageConversation[]
  materials          Material[]
  materialFavorites  MaterialFavorite[]
  materialLikes      MaterialLike[]
  materialReports    MaterialReport[]
  feedbacks          Feedback[]
  adminAuditLogs     AdminAuditLog[]
  registrationEvents RegistrationEvent[]
  dailyActivities    UserDailyActivity[]
  pptProjects        PptProject[]

  @@index([createdAt])
}

// Auth.js 标准表（预留 OAuth；session 策略用 JWT，但保留表结构便于扩展）
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- 业务模型 ----------

enum ModuleType {
  IMAGE
  VIDEO
  PROMPT_OPTIMIZER
  PPT
}

enum GenerationStatus {
  PENDING
  SUCCESS
  FAILED
}

// 所有 AI 模块共用一张生成记录表，靠 module 字段区分
model Generation {
  id             String           @id @default(cuid())
  userId         String
  module         ModuleType
  prompt         String
  params         String? // JSON 字符串（尺寸、数量等模块特有参数）
  status         GenerationStatus @default(PENDING)
  resultUrl      String? // 主结果地址；多结果时存 JSON 数组
  creditsCost    Int              @default(0)
  usedOwnKey     Boolean          @default(false) // true=用户自带 key（不扣分），false=平台
  error          String?
  providerSource String? // user/platform，便于排查用的是哪条通道
  providerModel  String? // 实际下发的模型
  upstreamStatus Int? // 上游 HTTP 状态码，如 524
  durationMs     Int? // 本轮生成总耗时
  imageCount     Int              @default(1)
  successCount   Int              @default(0)
  failedCount    Int              @default(0)
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([status, createdAt])
}

enum CreditTxType {
  SIGNUP_BONUS // 注册赠送
  CONSUME // 生成消耗
  RECHARGE // 充值
  ADMIN_ADJUST // 管理员调整
  REFUND // 生成失败退款
}

// 积分流水
model CreditTransaction {
  id           String       @id @default(cuid())
  userId       String
  amount       Int // 正为增加，负为减少
  type         CreditTxType
  balanceAfter Int // 交易后余额（便于审计）
  description  String?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

// 充值订单（首期支付走 Mock，预留真实网关）
model Order {
  id        String      @id @default(cuid())
  userId    String
  credits   Int // 购买的积分数
  amount    Int // 金额（单位：分）
  status    OrderStatus @default(PENDING)
  provider  String      @default("mock")
  createdAt DateTime    @default(now())
  paidAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([status, paidAt])
}

model RechargePackage {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  credits   Int
  amount    Int
  enabled   Boolean  @default(true)
  popular   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 系统设置：key-value，管理员后台可改
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  enabled   Boolean   @default(true)
  note      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model RegistrationEvent {
  id         String   @id @default(cuid())
  userId     String?
  email      String?
  provider   String
  ip         String?
  inviteCode String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ip, createdAt])
  @@index([provider, createdAt])
  @@index([userId, createdAt])
}

model UserDailyActivity {
  id          String   @id @default(cuid())
  userId      String
  day         String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@index([userId, lastSeenAt])
}

model SiteAnnouncement {
  id        String   @id @default(cuid())
  title     String
  content   String
  placement String   @default("APP")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, placement, updatedAt])
}

enum FeedbackType {
  FEATURE
  BUG
  EXPERIENCE
  BILLING
  OTHER
}

enum FeedbackModule {
  IMAGE
  MATERIALS
  CREDITS
  AUTH
  PROFILE
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Feedback {
  id             String         @id @default(cuid())
  userId         String
  type           FeedbackType
  module         FeedbackModule
  title          String
  content        String
  screenshotUrls String? // JSON 字符串数组，最多 3 张截图
  pagePath       String?
  status         FeedbackStatus @default(NEW)
  adminNote      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

// 平台上游 API 配置（管理员配置，每个模块一条）。用户走平台模型时使用。
model ProviderConfig {
  id           String     @id @default(cuid())
  module       ModuleType @unique
  baseUrl      String // 如 https://api.openai.com/v1
  apiKey       String // AES-256-GCM 加密存储
  model        String // 默认模型，如 dall-e-3 / gpt-image-1
  models       String? // JSON 字符串数组：同一 API 下允许用户切换的模型列表
  modelMeta    String? // JSON：模型启用状态、单价、备注等运营配置
  modelOptions String? // 保留字段：历史模型参数配置，当前不再使用
  enabled      Boolean    @default(true)
  updatedAt    DateTime   @updatedAt
}

// 用户自带 API 配置（BYOK，每用户每模块一条）。enabled 时走自己的 key、不扣积分。
model UserApiConfig {
  id           String     @id @default(cuid())
  userId       String
  module       ModuleType
  baseUrl      String
  apiKey       String // AES-256-GCM 加密存储
  model        String // 默认模型
  models       String? // JSON 字符串数组：同一 API 下允许切换的模型列表
  modelOptions String? // 保留字段：历史模型参数配置，当前不再使用
  enabled      Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

// ---------- 图片创作工作台（会话式） ----------

// 图片创作会话：一个会话含多轮生成（类似聊天）。仅 IMAGE 模块使用。
model ImageConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("新会话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns ImageTurn[]

  @@index([userId, updatedAt, id])
}

// 一轮生成（一次提交，含 1-N 张图）。images 是工作台状态源；
// 成功时另写一条 Generation 作审计/历史兼容层。
model ImageTurn {
  id                String           @id @default(cuid())
  conversationId    String
  prompt            String
  mode              String // "generate" | "edit"
  model             String // 使用的上游模型名快照
  ratio             String // UI 比例原值，如 "1:1"
  quality           String           @default("standard") // standard | hd | ultra
  pixelSize         String // 实际下发上游的像素，如 "1024x1024"
  count             Int              @default(1)
  status            GenerationStatus @default(PENDING)
  images            String? // JSON 数组：[{id,status,url?,error?}]，与前端 StoredImage 对齐
  referenceThumbs   String? // JSON 数组：图生图参考图的压缩缩略 data URL（仅展示用，可空）
  editInputPath     String? // 图生图原始参考图的不透明私有文件 token
  editInputName     String? // 上游 multipart 使用的原始文件名快照
  error             String?
  creditsCost       Int              @default(0)
  usedOwnKey        Boolean          @default(false)
  providerSource    String?
  upstreamStatus    Int?
  durationMs        Int?
  generationId      String? // 关联写入的 Generation id（便于回查）
  workerLease       String? // 独立 worker 抢占租约；为空表示等待消费
  startedAt         DateTime?
  heartbeatAt       DateTime?
  cancelRequestedAt DateTime?
  attemptCount      Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  conversation ImageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@index([status, workerLease, createdAt])
  @@index([status, heartbeatAt])
}

// ---------- 素材库 / 素材广场 ----------

enum MaterialType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  PROMPT
}

enum MaterialOwnerType {
  USER
  PLATFORM
}

enum MaterialSource {
  UPLOAD
  GENERATION
  REFERENCE
  PLATFORM
}

enum MaterialVisibility {
  PRIVATE
  PUBLIC
}

enum MaterialStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum MaterialReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// 通用素材表。第一版只开放 IMAGE，视频/音频等字段先预留。
model Material {
  id                 String             @id @default(cuid())
  ownerId            String?
  ownerType          MaterialOwnerType  @default(USER)
  type               MaterialType       @default(IMAGE)
  source             MaterialSource     @default(UPLOAD)
  visibility         MaterialVisibility @default(PRIVATE)
  status             MaterialStatus     @default(DRAFT)
  title              String
  description        String?
  tags               String? // JSON 字符串数组，MVP 先不拆标签表
  url                String
  storageKey         String?
  thumbnailUrl       String?
  promptText         String?
  promptMeta         String? // JSON：提示词适用模块、模式、比例、张数、模型等
  rejectionReason    String?
  reviewedAt         DateTime?
  mimeType           String?
  sizeBytes          Int?
  width              Int?
  height             Int?
  durationSec        Int?
  sourceGenerationId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner     User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites MaterialFavorite[]
  likes     MaterialLike[]
  reports   MaterialReport[]

  @@index([ownerId, createdAt])
  @@index([type, visibility, status, createdAt])
  @@index([visibility, status, updatedAt])
  @@index([ownerType, createdAt])
  @@index([storageKey])
}

model MaterialReport {
  id         String               @id @default(cuid())
  materialId String
  reporterId String
  reason     String
  status     MaterialReportStatus @default(OPEN)
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  reporter User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([materialId, createdAt])
  @@index([reporterId])
  @@index([status, createdAt])
}

model MaterialFavorite {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
}

model MaterialLike {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
}

// ---------- PPT 生成模块 ----------

enum PptProjectStatus {
  DRAFT // 旧版 PPT 模块草稿状态，保留用于兼容历史数据
  PENDING // 等待生成
  QUEUED // 队列中
  GENERATING // 旧版 PPT 模块生成中状态，保留用于兼容历史数据
  STRATEGIZING // Strategist 阶段
  AWAITING_CONFIRMATION // 等待用户确认设计方案
  ACQUIRING_IMAGES // 图片采集
  EXECUTING // Executor 渲染 SVG
  EXPORTING // 生成 PPTX
  READY // 旧版 PPT 模块完成状态，保留用于兼容历史数据
  COMPLETED // 完成
  FAILED // 失败
}

enum PptSourceType {
  TOPIC // 纯主题输入
  DOCUMENT // 上传文档（PDF/DOCX/PPTX）
  URL // 网页链接
  MARKDOWN // Markdown 输入
}

model PptProject {
  id     String @id @default(cuid())
  userId String
  title  String // 项目标题（用户输入或自动提取）

  // 旧版 PPT 模块字段：保留以兼容已存在的本地数据和过渡期迁移。
  topic        String?
  audience     String?
  sourceText   String?
  tone         String?
  language     String?
  model        String?
  outline      String?
  theme        String?
  generationId String?

  sourceType     PptSourceType @default(TOPIC)
  sourceTopic    String? // 主题描述（sourceType=TOPIC）
  sourceFileUrl  String? // 上传文档路径（sourceType=DOCUMENT）
  sourceUrl      String? // 网页 URL（sourceType=URL）
  sourceMarkdown String? // Markdown 内容（sourceType=MARKDOWN）

  status        PptProjectStatus @default(PENDING)
  currentPhase  String? // 当前阶段描述
  progress      Int              @default(0) // 0-100
  queuePosition Int? // 队列位置

  // 生成参数
  template    String? // 模板 ID（ppt169_general_dark_tech 等）
  slideCount  Int? // 目标页数
  aspectRatio String  @default("16:9") // 16:9 或 4:3
  style       String? // 风格（general/consultant/consultant-top）

  // 完整生成入参（JSON）：异步 worker 从此字段重建 GenerationParams。
  // 包含 prompt、sourceFileUrls、templateFileUrls、stylePrompt、styleLabel 等
  // 未在单独列上冗余的字段。其他字段（sourceType/template/slideCount 等）从行字段取。
  params String?

  // 输出路径（相对 public/ 或绝对路径）
  projectPath   String? // projects/<cuid>/
  specPath      String? // design_spec.md 路径
  specLockPath  String? // spec_lock.md 路径
  svgOutputPath String? // svg_output/ 目录
  pptxPath      String? // 最终 PPTX 文件路径

  // 执行日志
  logs  String? // 流式日志累积（换行分隔）
  error String?

  workerLease String? // 独立 worker 抢占租约；终态和排队状态必须为空

  // 积分与计费
  creditsCost Int     @default(0)
  usedOwnKey  Boolean @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?
  artifactsDeletedAt DateTime? // 生成文件按保留策略清理时间，项目元数据仍保留

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slides PptSlide[]

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([status, createdAt])
  @@index([status, workerLease, createdAt])
  @@index([status, updatedAt])
  @@index([status, completedAt])
  @@index([createdAt])
}

model PptSlide {
  id              String            @id
  projectId       String
  order           Int
  title           String
  subtitle        String?
  layout          String            @default("CONTENT")
  bullets         String?
  speakerNotes    String?
  visualPrompt    String?
  accent          String?
  imageUrl        String?
  imageStorageKey String?
  imagePrompt     String?
  imageModel      String?
  imageStatus     GenerationStatus?
  imageError      String?
  imageDurationMs Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime

  project PptProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
}

// 跨 Web 副本共享的原子限流桶。
model RateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  count           Int
  expiresAt       DateTime

  @@index([expiresAt])
}
