{
  "name": "ai-aggregator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run ppt-master:verify && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets:check": "node scripts/check-secret-patterns.mjs",
    "supply-chain:check": "node scripts/check-supply-chain-pins.mjs",
    "ppt-master:check-env": "node scripts/check-ppt-env.mjs",
    "ppt-master:verify": "tsx scripts/verify-ppt-master-upstream.ts",
    "ppt-quality:check": "tsx scripts/check-ppt-quality-regression.ts",
    "ppt-agent:check-tools": "node scripts/check-ppt-agent-extension.mjs",
    "ppt-requirements:lock": "sh scripts/compile-ppt-requirements.sh",
    "ppt-requirements:check": "sh scripts/compile-ppt-requirements.sh --check",
    "ppt-worker:build": "esbuild scripts/start-ppt-worker.ts --bundle --platform=node --target=node22 --format=cjs --minify-syntax --outfile=.next/ppt-worker.cjs --metafile=.next/ppt-worker-meta.json --external:@prisma/client --external:sharp",
    "ppt-worker:dev": "tsx scripts/start-ppt-worker.ts",
    "image-worker:build": "esbuild scripts/start-image-worker.ts --bundle --platform=node --target=node22 --format=cjs --outfile=.next/image-worker.cjs --metafile=.next/image-worker-meta.json --external:@prisma/client --external:sharp",
    "image-worker:dev": "tsx scripts/start-image-worker.ts",
    "worker-bundles:check": "node scripts/check-worker-bundles.mjs",
    "compose:isolation:check": "node scripts/check-compose-isolation.mjs",
    "image-worker:check-integration": "tsx scripts/check-image-worker-integration.ts",
    "image-conversation:check-integration": "tsx scripts/check-image-conversation-integration.ts",
    "ppt-queue:check-integration": "tsx scripts/check-ppt-queue-integration.ts",
    "registration:check-integration": "tsx scripts/check-registration-integration.ts",
    "storage:check-integration": "tsx scripts/check-storage-retention-integration.ts",
    "storage-quota:check-integration": "tsx scripts/check-upload-storage-integration.ts",
    "postinstall": "prisma generate",
    "prod:check-env": "tsx scripts/check-production-env.ts",
    "prod:compose": "node scripts/production-compose.mjs",
    "prod:build-images": "sh scripts/build-production-images.sh",
    "prod:check-images": "sh scripts/check-production-images-runtime.sh",
    "prod:health": "tsx scripts/check-production-health.ts",
    "prod:check-user-journey": "node scripts/check-production-user-journey.mjs",
    "prod:backup": "tsx scripts/backup-production-data.ts",
    "prod:backup:verify": "tsx scripts/verify-production-backup.ts",
    "prod:restore:drill": "tsx scripts/drill-production-restore.ts",
    "prod:restore": "tsx scripts/restore-production-data.ts",
    "backup:check-integration": "sh scripts/check-backup-restore-integration.sh",
    "db:indexes:check": "node scripts/check-database-indexes.mjs",
    "db:indexes:check-integration": "node scripts/check-database-index-migration.mjs",
    "db:readiness:check-integration": "tsx scripts/check-database-readiness-integration.ts",
    "queue-capacity:check-integration": "tsx scripts/check-queue-capacity-integration.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "saxes": "^6.0.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "postcss": "^8.5.15",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
