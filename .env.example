# 数据库
DATABASE_URL="postgresql://ai_aggregator:local-postgres-password@localhost:5432/ai_aggregator?schema=public"
POSTGRES_PASSWORD="local-postgres-password"
# Prisma 连接池默认按服务限制为 Web 10、图片 Worker 5、PPT Worker 5。
# DATABASE_URL 中显式的 connection_limit / pool_timeout 参数优先于以下配置。
# APP_DATABASE_CONNECTION_LIMIT=10
# IMAGE_WORKER_DATABASE_CONNECTION_LIMIT=5
# PPT_WORKER_DATABASE_CONNECTION_LIMIT=5
# DATABASE_POOL_TIMEOUT_SECONDS=10
# POSTGRES_MAX_CONNECTIONS=100
# DATABASE_RESERVED_CONNECTIONS=10
# 可选：指定 Python 3.10+ 运行 PPT Master 工具链；留空时使用 PATH 中的 python3。
PPT_PYTHON_CMD=""

# Auth.js - 生产环境务必替换为随机强密钥（npx auth secret）
AUTH_SECRET="please-generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"
# 求职展示用只读游客入口；仅字面值 true 会启用。
GUEST_MODE_ENABLED="false"

# API Key 加密密钥：64 位 hex = 32 字节，用 `openssl rand -hex 32` 生成
# 警告：更换此值会导致已存储的 API Key 无法解密
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# 用户上传统一保存在私有目录；浏览器只能通过鉴权文件接口访问。
# Docker Compose 已挂载 data/uploads，通常无需覆盖。
# UPLOAD_STORAGE_ROOT="/absolute/path/to/private/uploads"
# MATERIAL_UPLOAD_ROOT=""
# FEEDBACK_UPLOAD_ROOT=""
# MATERIAL_USER_QUOTA_BYTES=1073741824
# MATERIAL_USER_MAX_FILES=2000
# FEEDBACK_USER_QUOTA_BYTES=104857600
# FEEDBACK_USER_MAX_FILES=100
# 无数据库引用的素材/反馈图片会在保留期后由图片 Worker 清理：
# UPLOAD_ORPHAN_RETENTION_HOURS=24
# UPLOAD_STORAGE_SWEEP_MS=21600000
# UPLOAD_STORAGE_SWEEP_TIMEOUT_MS=600000

# 私有 Prometheus 指标端点 /api/health/metrics 的 Bearer Token
METRICS_TOKEN="please-generate-a-random-metrics-token"
# 生产健康审计默认检查磁盘、数据库、队列、退款和 Compose 服务；阈值见 .env.production.example。

# 站点公开信息
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_ICP=""

# 可选的一次性管理员初始化；两项留空时 seed 不创建管理员。
# 创建完成后无需长期保留管理员明文口令。
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="管理员"

# PPT 生成模块
# 固定使用 pi CLI agent 跑完整 ppt-master skill 工作流；没有 API/hosted/custom fallback。
# 每次任务通过 `pi --skill <项目内 .ppt-master-skill 副本> ...` 加载 skill；
# 不会修改全局 pi 配置。Docker 镜像会安装固定版本 pi，每个任务使用
# /tmp 下的临时 pi 配置，API Key 仅通过子进程环境传递，任务结束后删除。
# 运行时会把 ppt-master 复制到项目目录，agent 即使临时修工具也只会影响该项目副本。
PPT_AGENT_MODEL=""
# 默认复用后台「PPT 生成」平台上游配置。若要显式指定独立上游，设置：
# PPT_PI_USE_PLATFORM_CONFIG=false
# PPT_PI_PROVIDER="ppt-platform"
# PPT_PI_BASE_URL="https://api.example.com/v1"
# PPT_PI_API_KEY="sk-..."
# PPT_PI_MODEL="gpt-5.4-mini"
# PPT_PI_API_TYPE="openai-completions"
# pi 禁用全部内置工具，只加载 scripts/ppt-agent-extension.mjs 提供的项目目录白名单工具。
# 其中 bash 兼容入口仅允许执行批准的 PPT Master Python 脚本，不能执行任意系统命令。
PPT_AGENT_TIMEOUT_MS=7200000
# Executor 或模板流程连续无关键产物的单轮超时（默认 15 分钟）。
PPT_AGENT_NO_ARTIFACT_TIMEOUT_MS=900000
# 将正式规划和 Executor 的官方必读原文按哈希一次性注入，减少重复工具读取。
# 超过体积上限时自动回退原逐文件读取流程，不改变模型、推理强度或质量门。
PPT_AGENT_INLINE_CONTEXT=true
PPT_AGENT_INLINE_CONTEXT_MAX_BYTES=2097152
# pi 可能在长任务中分轮结束；留空时按页数自动计算续跑轮次。
PPT_AGENT_MAX_TURNS=""
# Executor 连续多少轮没有新增 SVG 时停止，避免无页面产出时持续消耗 Token。
PPT_EXECUTOR_MAX_NO_PROGRESS_TURNS=2
# 原生模板流程连续多少轮没有进入下一关键阶段时停止。
PPT_TEMPLATE_MAX_NO_PROGRESS_TURNS=2
# 聚合站使用站内 SVG 预览，默认清理 agent 意外启动的本地 live preview 服务。
PPT_AGENT_KEEP_LIVE_PREVIEW=false
PPT_CREDITS_PER_SLIDE=10

# 生成任务异步化：generate 路由只入队（QUEUED），由独立 ppt-worker 进程消费。
# Docker Compose 会自动启动 ppt-worker；本地开发另开终端运行 npm run ppt-worker:dev。
# 多副本安全：队列用 SELECT ... FOR UPDATE SKIP LOCKED 抢占，每个 worker 抢到的项目互不相同。
# 单副本内并发上限（消费循环与进程内信号量共用，范围 1-10）：
# PPT_AGENT_MAX_CONCURRENT=3
# worker 轮询间隔（毫秒）：
# PPT_WORKER_POLL_MS=2000
# worker 数据库心跳间隔与健康检查最大容忍时间（毫秒）：
# PPT_WORKER_HEARTBEAT_MS=10000
# PPT_WORKER_HEALTH_MAX_AGE_MS=45000
# 孤儿任务扫描间隔（毫秒），释放心跳停止的孤儿项目并退款：
# PPT_WORKER_SWEEP_MS=30000
# 孤儿恢复阈值（毫秒），留空时为 pi agent 超时 + 10 分钟缓冲：
# PPT_STALE_ACTIVE_PROJECT_MS=

# 待处理上传的用户配额、保留时间及存储清理周期：
# PPT_UPLOAD_USER_QUOTA_BYTES=209715200
# PPT_UPLOAD_USER_MAX_FILES=50
# PPT_UPLOAD_RETENTION_HOURS=24
# PPT_ORPHAN_PROJECT_RETENTION_HOURS=24
# PPT_STORAGE_SWEEP_MS=21600000
# PPT_STORAGE_SWEEP_TIMEOUT_MS=600000
# 已完成/失败项目生成文件固定保留 7 天，项目元数据继续保留。

# 图片生成异步队列、重试与私有参考图清理；生成结果固定保留 7 天：
# IMAGE_WORKER_CONCURRENCY=2 # 范围 1-10
# IMAGE_GLOBAL_MAX_PENDING=100 # 全站等待或执行中的图片任务上限
# IMAGE_WORKER_POLL_MS=1500
# IMAGE_WORKER_SWEEP_MS=30000
# IMAGE_CONVERSATION_WRITE_RATE_MAX=60
# IMAGE_CONVERSATION_WRITE_RATE_WINDOW_MS=60000
# IMAGE_WORKER_HEARTBEAT_MS=10000
# IMAGE_WORKER_HEALTH_MAX_AGE_MS=45000
# IMAGE_WORKER_MAX_ATTEMPTS=3 # 范围 1-10
# IMAGE_UPSTREAM_MAX_ATTEMPTS=2 # 范围 1-10
# IMAGE_USER_MAX_PENDING=3 # 范围 1-100
# IMAGE_INPUT_RETENTION_HOURS=24
# IMAGE_INPUT_SWEEP_MS=21600000

# Docker Compose 资源上限（可根据 VPS 规格调整）：
# POSTGRES_MEMORY_LIMIT=1g
# POSTGRES_CPU_LIMIT=1.0
# APP_MEMORY_LIMIT=1g
# APP_CPU_LIMIT=1.5
# PPT_WORKER_MEMORY_LIMIT=2g
# PPT_WORKER_CPU_LIMIT=2.0
# IMAGE_WORKER_MEMORY_LIMIT=1g
# IMAGE_WORKER_CPU_LIMIT=1.5
# CADDY_MEMORY_LIMIT=256m
# CADDY_CPU_LIMIT=0.5
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILES=5

# 接口限流（PostgreSQL 共享固定窗口，按用户计数）：每窗口内最大次数 / 窗口毫秒数。
# PPT_GENERATE_RATE_MAX=10
# PPT_GENERATE_RATE_WINDOW_MS=60000
# PPT_GLOBAL_MAX_PENDING=30
# PPT_UPLOAD_RATE_MAX=20
# PPT_UPLOAD_RATE_WINDOW_MS=60000
# API_TEST_RATE_MAX=10
# API_TEST_RATE_WINDOW_MS=60000
# AUTH_LOGIN_RATE_MAX=10
# AUTH_LOGIN_RATE_WINDOW_MS=300000
# AUTH_LOGIN_ACCOUNT_RATE_MAX=30
# AUTH_LOGIN_ACCOUNT_RATE_WINDOW_MS=900000
# REGISTER_RATE_MAX=5
# REGISTER_RATE_WINDOW_MS=3600000
# IMAGE_GENERATE_RATE_MAX=20
# IMAGE_GENERATE_RATE_WINDOW_MS=60000
# IMAGE_CANCEL_RATE_MAX=30
# IMAGE_CANCEL_RATE_WINDOW_MS=60000
# PROMPT_OPTIMIZE_RATE_MAX=20
# PROMPT_OPTIMIZE_RATE_WINDOW_MS=60000
# MATERIAL_UPLOAD_RATE_MAX=20
# MATERIAL_UPLOAD_RATE_WINDOW_MS=60000
# MATERIAL_SAVE_RATE_MAX=30
# MATERIAL_SAVE_RATE_WINDOW_MS=60000
# MATERIAL_REPORT_RATE_MAX=10
# MATERIAL_REPORT_RATE_WINDOW_MS=3600000
# RECHARGE_RATE_MAX=10
# RECHARGE_RATE_WINDOW_MS=600000
# PASSWORD_CHANGE_RATE_MAX=5
# PASSWORD_CHANGE_RATE_WINDOW_MS=900000

# 用户图片素材与生成结果的本地存储配额：
# MATERIAL_USER_QUOTA_BYTES=1073741824
# MATERIAL_USER_MAX_FILES=2000

# 支付回调来源 IP 白名单（逗号分隔 IP/CIDR，留空则仅依赖 MD5 签名校验）：
# LINUX_DO_CREDIT_NOTIFY_IP_ALLOWLIST=
