# 数据库
DATABASE_URL="postgresql://ai_aggregator:local-postgres-password@localhost:5432/ai_aggregator?schema=public"
POSTGRES_PASSWORD="local-postgres-password"

# Auth.js - 生产环境务必替换为随机强密钥（npx auth secret）
AUTH_SECRET="please-generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"

# API Key 加密密钥：64 位 hex = 32 字节，用 `openssl rand -hex 32` 生成
# 警告：更换此值会导致已存储的 API Key 无法解密
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# 站点公开信息
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_ICP=""

# 默认管理员账号（由 seed 创建）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123456"
ADMIN_NAME="管理员"

# PPT 生成模块
# 默认使用站内「PPT 生成」API 配置（用户自带 Key 或平台上游）。
# 如需高还原 ppt-master/Claude Code 路线，可显式设置 PPT_AGENT_MODE="cli"。
PPT_AGENT_MODE="api"
# API 模式优先使用 OpenAI-compatible tool calls；上游不支持时会自动回退纯文本。
PPT_AGENT_API_TOOLS=true
# CLI 模式需要服务器安装并登录一个 CLI agent（默认 claude）。
# CLI 命令等价于：claude -p --model ${PPT_AGENT_MODEL:-opus}
PPT_AGENT_BINARY="claude"
PPT_AGENT_MODEL="opus"
# 无人值守生成需要自动允许写入项目目录和运行 Python 工具。
# 生产环境请用专门的低权限系统用户运行 Next 服务，并只挂载必要目录。
PPT_AGENT_PERMISSION_MODE="bypassPermissions"
PPT_AGENT_TIMEOUT_MS=7200000
# Claude Code print 模式会在工具调用边界返回，PPT Master 需要多轮 resume 才能逐页写完。
# 留空时按页数自动计算；生产环境显式配置时，5 页建议至少 28。
PPT_AGENT_MAX_TURNS=""
# 聚合站使用站内 SVG 预览，默认清理 agent 意外启动的本地 live preview 服务。
PPT_AGENT_KEEP_LIVE_PREVIEW=false
PPT_AGENT_MAX_BUDGET_USD=""
# 若生产环境用自定义 runner，可设置：
# PPT_AGENT_COMMAND="codex"
# PPT_AGENT_ARGS='["exec","-C","{projectDir}","--add-dir","{skillDir}","--sandbox","danger-full-access","--ask-for-approval","never","-"]'
# api 模式会读取用户/平台 PPT API 配置；cli 模式使用服务器 CLI agent 凭据。
PPT_CREDITS_PER_SLIDE=10
