# 数据库
DATABASE_URL="postgresql://ai_aggregator:local-postgres-password@localhost:5432/ai_aggregator?schema=public"
POSTGRES_PASSWORD="local-postgres-password"
# 可选：指定 Python 3.10+ 运行 PPT Master 工具链；留空时使用 PATH 中的 python3。
PPT_PYTHON_CMD=""

# Auth.js - 生产环境务必替换为随机强密钥（npx auth secret）
AUTH_SECRET="please-generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"

# API Key 加密密钥：64 位 hex = 32 字节，用 `openssl rand -hex 32` 生成
# 警告：更换此值会导致已存储的 API Key 无法解密
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# 站点公开信息
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_ICP=""

# 默认管理员账号（由 seed 创建）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123456"
ADMIN_NAME="管理员"

# PPT 生成模块
# 固定使用 pi CLI agent 跑完整 ppt-master skill 工作流；没有 API/hosted/custom fallback。
# 每次任务通过 `pi --skill <项目内 .ppt-master-skill 副本> ...` 加载 skill；
# 不会修改全局 pi 配置。Docker 镜像会安装固定版本 pi，启动时默认从后台
# PPT 平台上游配置生成容器内专用 pi 配置（/app/data/pi-agent）。
# 运行时会把 ppt-master 复制到项目目录，agent 即使临时修工具也只会影响该项目副本。
PPT_AGENT_MODEL=""
# 默认复用后台「PPT 生成」平台上游配置。若要显式指定独立上游，设置：
# PPT_PI_USE_PLATFORM_CONFIG=false
# PPT_PI_PROVIDER="ppt-platform"
# PPT_PI_BASE_URL="https://api.example.com/v1"
# PPT_PI_API_KEY="sk-..."
# PPT_PI_MODEL="gpt-5.4-mini"
# PPT_PI_API_TYPE="openai-completions"
# pi 默认工具：read,write,bash,grep,find,ls。需要覆盖可设置 PPT_PI_AGENT_TOOLS。
# PPT_PI_AGENT_TOOLS="read,write,bash,grep,find,ls"
# 无人值守生成需要自动允许写入项目目录和运行 Python 工具。
PPT_AGENT_TIMEOUT_MS=7200000
# pi 可能在长任务中分轮结束；留空时按页数自动计算续跑轮次。
PPT_AGENT_MAX_TURNS=""
# 聚合站使用站内 SVG 预览，默认清理 agent 意外启动的本地 live preview 服务。
PPT_AGENT_KEEP_LIVE_PREVIEW=false
PPT_CREDITS_PER_SLIDE=10

# 生成任务异步化：generate 路由只入队（QUEUED），由进程内 worker 轮询 Postgres 队列消费。
# worker 在 next start 进程内运行，首次 generate 请求时幂等启动，进程存活期间持续消费。
# 多副本安全：队列用 SELECT ... FOR UPDATE SKIP LOCKED 抢占，每个 worker 抢到的项目互不相同。
# 单副本内并发上限（进程内信号量）：
# PPT_AGENT_MAX_CONCURRENT=3
# worker 轮询间隔（毫秒）：
# PPT_WORKER_POLL_MS=2000
# 孤儿任务扫描间隔（毫秒），释放心跳停止的孤儿项目并退款：
# PPT_WORKER_SWEEP_MS=30000
# 孤儿恢复阈值（毫秒），留空时为 pi agent 超时 + 10 分钟缓冲：
# PPT_STALE_ACTIVE_PROJECT_MS=

# 接口限流（进程内滑动窗口，按用户计数）：每窗口内最大次数 / 窗口毫秒数。
# PPT_GENERATE_RATE_MAX=10
# PPT_GENERATE_RATE_WINDOW_MS=60000
# PPT_UPLOAD_RATE_MAX=20
# PPT_UPLOAD_RATE_WINDOW_MS=60000
# API_TEST_RATE_MAX=10
# API_TEST_RATE_WINDOW_MS=60000

# 支付回调来源 IP 白名单（逗号分隔 IP/CIDR，留空则仅依赖 MD5 签名校验）：
# LINUX_DO_CREDIT_NOTIFY_IP_ALLOWLIST=
