DATABASE_URL="postgresql://ai_aggregator:replace-with-postgres-password@postgres:5432/ai_aggregator?schema=public"
POSTGRES_PASSWORD="replace-with-postgres-password"

# Prisma 连接池预算：默认总计 20，另为迁移、备份和运维保留 10 条连接。
# DATABASE_URL 中显式的 connection_limit 会同时覆盖三个服务，请谨慎使用。
APP_DATABASE_CONNECTION_LIMIT="10"
IMAGE_WORKER_DATABASE_CONNECTION_LIMIT="5"
PPT_WORKER_DATABASE_CONNECTION_LIMIT="5"
DATABASE_POOL_TIMEOUT_SECONDS="10"
POSTGRES_MAX_CONNECTIONS="100"
DATABASE_RESERVED_CONNECTIONS="10"

# 可按 VPS 规格覆盖 docker-compose.yml 的默认资源上限
POSTGRES_MEMORY_LIMIT="1g"
POSTGRES_CPU_LIMIT="1.0"
APP_MEMORY_LIMIT="1g"
APP_CPU_LIMIT="1.5"
PPT_WORKER_MEMORY_LIMIT="2g"
PPT_WORKER_CPU_LIMIT="2.0"
IMAGE_WORKER_MEMORY_LIMIT="1g"
IMAGE_WORKER_CPU_LIMIT="1.5"
CADDY_MEMORY_LIMIT="256m"
CADDY_CPU_LIMIT="0.5"
DOCKER_LOG_MAX_SIZE="10m"
DOCKER_LOG_MAX_FILES="5"

AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"
APP_URL="https://ai.kitnav.com"
AUTH_URL="https://ai.kitnav.com"
# 启用后，登录页显示只读游客参观入口。
GUEST_MODE_ENABLED="false"

ENCRYPTION_KEY="replace-with-64-hex-chars"
METRICS_TOKEN="replace-with-a-random-metrics-token-at-least-32-chars"

# `npm run prod:health` 的告警阈值（通常保留默认值即可）
# PROD_HEALTH_HTTP_TIMEOUT_MS="10000"
# PROD_HEALTH_MIN_DISK_AVAILABLE_PERCENT="15"
# PROD_HEALTH_MAX_DB_QUERY_SECONDS="2"
# PROD_HEALTH_MAX_DB_CONNECTION_UTILIZATION_PERCENT="80"
# PROD_HEALTH_MAX_IMAGE_QUEUE_AGE_SECONDS="1800"
# PROD_HEALTH_MAX_PPT_QUEUE_AGE_SECONDS="9000"
# PROD_HEALTH_MAX_QUEUE_UTILIZATION_PERCENT="90"
# PROD_HEALTH_MAX_PENDING_PPT_REFUNDS="0"

# 全站队列背压上限；达到上限后新任务在扣费前返回服务繁忙。
# IMAGE_GLOBAL_MAX_PENDING="100"
# PPT_GLOBAL_MAX_PENDING="30"

# Web 接口限流；通常保留默认值，受攻击或高并发时再调整。
# AUTH_LOGIN_RATE_MAX="10"
# AUTH_LOGIN_RATE_WINDOW_MS="300000"
# AUTH_LOGIN_ACCOUNT_RATE_MAX="30"
# AUTH_LOGIN_ACCOUNT_RATE_WINDOW_MS="900000"
# REGISTER_RATE_MAX="5"
# REGISTER_RATE_WINDOW_MS="3600000"
# PASSWORD_CHANGE_RATE_MAX="5"
# PASSWORD_CHANGE_RATE_WINDOW_MS="900000"
# RECHARGE_RATE_MAX="10"
# RECHARGE_RATE_WINDOW_MS="600000"
# API_TEST_RATE_MAX="10"
# API_TEST_RATE_WINDOW_MS="60000"
# IMAGE_GENERATE_RATE_MAX="10"
# IMAGE_GENERATE_RATE_WINDOW_MS="60000"
# IMAGE_CANCEL_RATE_MAX="30"
# IMAGE_CANCEL_RATE_WINDOW_MS="60000"
# IMAGE_CONVERSATION_WRITE_RATE_MAX="60"
# IMAGE_CONVERSATION_WRITE_RATE_WINDOW_MS="60000"
# PROMPT_OPTIMIZE_RATE_MAX="20"
# PROMPT_OPTIMIZE_RATE_WINDOW_MS="60000"
# MATERIAL_UPLOAD_RATE_MAX="20"
# MATERIAL_UPLOAD_RATE_WINDOW_MS="60000"
# MATERIAL_SAVE_RATE_MAX="30"
# MATERIAL_SAVE_RATE_WINDOW_MS="60000"
# MATERIAL_REPORT_RATE_MAX="10"
# MATERIAL_REPORT_RATE_WINDOW_MS="3600000"
# PPT_GENERATE_RATE_MAX="10"
# PPT_GENERATE_RATE_WINDOW_MS="60000"
# PPT_UPLOAD_RATE_MAX="20"
# PPT_UPLOAD_RATE_WINDOW_MS="60000"

# Compose 默认使用 /app/data/uploads，对应宿主机 data/uploads。
# UPLOAD_STORAGE_ROOT="/app/data/uploads"
# UPLOAD_ORPHAN_RETENTION_HOURS="24"
# UPLOAD_STORAGE_SWEEP_MS="21600000"
# UPLOAD_STORAGE_SWEEP_TIMEOUT_MS="600000"

# Compose 默认使用 /app/data/ppt-uploads 和 /app/data/ppt-projects。
# PPT_UPLOAD_ROOT="/app/data/ppt-uploads"
# PPT_STORAGE_SWEEP_TIMEOUT_MS="600000"

# 可选的一次性管理员初始化；生产环境通常留空并使用现有管理员账号。
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="管理员"

LINUX_DO_CLIENT_ID=""
LINUX_DO_CLIENT_SECRET=""
LINUX_DO_ISSUER="https://connect.linux.do/"

RECHARGE_PROVIDER="disabled"
LINUX_DO_CREDIT_PID=""
LINUX_DO_CREDIT_KEY=""
LINUX_DO_CREDIT_GATEWAY="https://credit.linux.do/epay"
# 可选：限制支付回调来源，支持逗号分隔的 IP 或 CIDR。
LINUX_DO_CREDIT_NOTIFY_IP_ALLOWLIST=""
